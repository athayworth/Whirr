<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Whirr</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.athayworth.whirr</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Whirr</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSLocationUsageDescription</key>
    <string>Optional: macOS only shares Wi-Fi network names with apps that have Location access. Whirr uses them to tell your network apart from your neighbours' in the connection test. It never uses your location or stores network names.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Optional: macOS only shares Wi-Fi network names with apps that have Location access. Whirr uses them to tell your network apart from your neighbours' in the connection test. It never uses your location or stores network names.</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>MIT License</string>

    <!-- Sparkle auto-update. Swap SUFeedURL for your real appcast host
         when you're ready to ship. Swap SUPublicEDKey for the public
         half of the EdDSA keypair `sparkle/bin/generate_keys` produces
         (the private half stays in your Keychain and is used by
         `sparkle/bin/sign_update` at release time). See README's
         "Release flow" section. -->
    <key>SUFeedURL</key>
    <string>https://YOUR_DOMAIN/whirr/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>YOUR_BASE64_PUBLIC_KEY_HERE</string>
    <!-- Background check cadence is Sparkle's default (~once per day);
         override with SUScheduledCheckInterval (seconds) if needed. -->
    <key>SUEnableAutomaticChecks</key>
    <true/>
</dict>
</plist>
