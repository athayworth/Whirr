<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.athayworth.whirr.sampler</string>

    <!-- BundleProgram: path to the daemon binary, relative to the bundle
         root. Preferred over Program/ProgramArguments[0] for SMAppService
         daemons — macOS resolves it against the running app bundle, so the
         daemon keeps working when the user moves Whirr.app. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/whirr-sampler</string>

    <key>ProgramArguments</key>
    <array>
        <string>whirr-sampler</string>
        <string>--output</string>
        <string>/Library/Application Support/Whirr/snapshot.json</string>
        <string>--interval</string>
        <string>3</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- If the daemon crashes, wait this long before restarting. Prevents
         a crash-loop from spamming the system log. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Background priority so it never competes with foreground work. -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/var/log/whirr-sampler.log</string>

    <key>StandardErrorPath</key>
    <string>/var/log/whirr-sampler.log</string>
</dict>
</plist>
